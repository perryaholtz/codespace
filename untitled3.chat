              "command": "python3 -c \"\nimport json\nfor f in ['notebooks/16-lecture-neural-networks.ipynb','notebooks/13-lecture-random-forest.ipynb','exercises/13-spotify-exercise.ipynb']:\n    print('###############',f)\n    nb=json.load(open(f))\n    for i,c in enumerate(nb['cells']):\n        if c['cell_type']!='code': continue\n        src=''.join(c['source'])\n        if any(k in src.lower() for k in ['ggplot','geom_','plot','predict','boundary','grid']):\n            print('=== cell',i)\n            print(src)\n            print()\n\""
