            "title": ".pixi/envs/default/lib/python3.14/site-packages/jupyter_ai_tools/toolkits/notebook.py",
            "tool_call_id": "call_962fcb0261e6488088fef0e0",
            "raw_output": {
              "metadata": {
                "loaded": [],
                "truncated": true,
                "display": {
                  "path": "/workspaces/codespace/.pixi/envs/default/lib/python3.14/site-packages/jupyter_ai_tools/toolkits/notebook.py",
                  "lineStart": 180.0,
                  "lineEnd": 299.0,
                  "type": "file",
                  "totalLines": 1659.0,
                  "text": "async def read_notebook(file_path: str, include_outputs=False) -> str:\n    \"\"\"Returns the complete notebook content as markdown string.\n\n    This function reads a Jupyter notebook file and converts its content to a markdown string.\n    It uses the read_notebook_json function to read the notebook file and then converts\n    the resulting JSON to markdown.\n\n    Args:\n        file_path:\n            The relative path to the notebook file on the filesystem.\n        include_outputs:\n            If True, cell outputs will be included in the markdown. Default is False.\n\n    Returns:\n        The notebook content as a markdown string.\n    \"\"\"\n    try:\n        notebook_dict = await read_notebook_json(file_path)\n        notebook_md = notebook_json_to_md(notebook_dict, include_outputs=include_outputs)\n        return notebook_md\n    except Exception:\n        raise\n\n\nasync def read_notebook_json(file_path: str) -> Dict[str, Any]:\n    \"\"\"Returns the complete notebook content as a JSON dictionary.\n\n    This is the single choke point every read tool goes through to obtain the\n    notebook as an nbformat dict.\n\n    When no RTC provider is active (the RTC-free case), the write tools mutate\n    the live in-browser notebook model via jupyterlab-ai-commands *without*\n    saving to disk -- saving is left to the human. Reading from disk would\n    therefore return stale content (see issue #39). To stay consistent with the\n    write tools, we read the live model through the\n    ``jupyterlab-ai-commands:get-notebook-content`` frontend command, which\n    returns the current (possibly unsaved) nbformat JSON.\n\n    When an RTC provider is active, the server owns a live YDoc that is synced\n    to the filesystem, so the on-disk content is already current and we read it\n    directly.\n\n    Args:\n        file_path:\n            The relative path to the notebook file. Passed to the frontend\n            command as-is (mirroring the write tools); normalized to an absolute\n            filesystem path only for the on-disk read.\n\n    Returns:\n        A dictionary containing the complete notebook structure.\n    \"\"\"\n    if not rtc_available():\n        # RTC-free: read the live model (mirrors how the write tools operate).\n        res = await run_lab_command(\n            \"jupyterlab-ai-commands:get-notebook-content\",\n            {\"notebookPath\": file_path},\n        )\n        # execute_command wraps the command's return value under \"result\".\n        payload = res.get(\"result\", res) if isinstance(res, dict) else res\n        return payload[\"content\"]\n\n    normalized_path = normalize_filepath(file_path)\n    with open(normalized_path, \"r\", encoding=\"utf-8\") as f:\n        notebook_dict = json.load(f)\n        return notebook_dict\n\n\nasync def read_cell(file_path: str, cell_id: str, include_outputs: bool = True) -> str:\n    \"\"\"Returns the notebook cell as a markdown string.\n\n    This function reads a specific cell from a Jupyter notebook file and converts\n    it to a markdown string. It uses the read_cell_json function to read the cell\n    and then converts it to markdown.\n\n    Args:\n        file_path:\n            The relative path to the notebook file on the filesystem.\n        cell_id:\n            The nbformat id of the cell.\n        include_outputs:\n            If True, cell outputs will be included in the markdown. Default is True.\n\n    Returns:\n        The cell content as a markdown string.\n\n    Raises:\n        LookupError: If no cell with the given ID is found.\n    \"\"\"\n    try:\n        # Resolve cell_id in case it's an index\n        resolved_cell_id = cell_id\n        cell, cell_index = await read_cell_json(file_path, resolved_cell_id)\n        cell_md = cell_to_md(cell, cell_index)\n        return cell_md\n    except Exception:\n        raise\n\n\nasync def read_cell_json(file_path: str, cell_id: str) -> Tuple[Dict[str, Any], int]:\n    \"\"\"Returns the notebook cell as a JSON dictionary and its index.\n\n    This function reads a specific cell from a Jupyter notebook file and returns\n    both the cell content as a dictionary and the cell's index within the notebook.\n\n    Args:\n        file_path:\n            The relative path to the notebook file on the filesystem.\n        cell_id:\n            The nbformat id of the cell.\n\n    Returns:\n        A tuple containing:\n        - The cell as a dictionary\n        - The index of the cell in the notebook\n\n    Raises:\n        LookupError: If no cell with the given ID is found.\n    \"\"\"\n    try:\n        # Resolve cell_id in case it's an index",
                  "truncated": true
                },
                "preview": "async def read_notebook(file_path: str, include_outputs=False) -> str:\n    \"\"\"Returns the complete notebook content as markdown string.\n\n    This function reads a Jupyter notebook file and converts its content to a markdown string.\n    It uses the read_notebook_json function to read the notebook file and then converts\n    the resulting JSON to markdown.\n\n    Args:\n        file_path:\n            The relative path to the notebook file on the filesystem.\n        include_outputs:\n            If True, cell outputs will be included in the markdown. Default is False.\n\n    Returns:\n        The notebook content as a markdown string.\n    \"\"\"\n    try:\n        notebook_dict = await read_notebook_json(file_path)\n        notebook_md = notebook_json_to_md(notebook_dict, include_outputs=include_outputs)\n        return notebook_md"
              },
              "output": "<path>/workspaces/codespace/.pixi/envs/default/lib/python3.14/site-packages/jupyter_ai_tools/toolkits/notebook.py</path>\n<type>file</type>\n<content>\n180: async def read_notebook(file_path: str, include_outputs=False) -> str:\n181:     \"\"\"Returns the complete notebook content as markdown string.\n182: \n183:     This function reads a Jupyter notebook file and converts its content to a markdown string.\n184:     It uses the read_notebook_json function to read the notebook file and then converts\n185:     the resulting JSON to markdown.\n186: \n187:     Args:\n188:         file_path:\n189:             The relative path to the notebook file on the filesystem.\n190:         include_outputs:\n191:             If True, cell outputs will be included in the markdown. Default is False.\n192: \n193:     Returns:\n194:         The notebook content as a markdown string.\n195:     \"\"\"\n196:     try:\n197:         notebook_dict = await read_notebook_json(file_path)\n198:         notebook_md = notebook_json_to_md(notebook_dict, include_outputs=include_outputs)\n199:         return notebook_md\n200:     except Exception:\n201:         raise\n202: \n203: \n204: async def read_notebook_json(file_path: str) -> Dict[str, Any]:\n205:     \"\"\"Returns the complete notebook content as a JSON dictionary.\n206: \n207:     This is the single choke point every read tool goes through to obtain the\n208:     notebook as an nbformat dict.\n209: \n210:     When no RTC provider is active (the RTC-free case), the write tools mutate\n211:     the live in-browser notebook model via jupyterlab-ai-commands *without*\n212:     saving to disk -- saving is left to the human. Reading from disk would\n213:     therefore return stale content (see issue #39). To stay consistent with the\n214:     write tools, we read the live model through the\n215:     ``jupyterlab-ai-commands:get-notebook-content`` frontend command, which\n216:     returns the current (possibly unsaved) nbformat JSON.\n217: \n218:     When an RTC provider is active, the server owns a live YDoc that is synced\n219:     to the filesystem, so the on-disk content is already current and we read it\n220:     directly.\n221: \n222:     Args:\n223:         file_path:\n224:             The relative path to the notebook file. Passed to the frontend\n225:             command as-is (mirroring the write tools); normalized to an absolute\n226:             filesystem path only for the on-disk read.\n227: \n228:     Returns:\n229:         A dictionary containing the complete notebook structure.\n230:     \"\"\"\n231:     if not rtc_available():\n232:         # RTC-free: read the live model (mirrors how the write tools operate).\n233:         res = await run_lab_command(\n234:             \"jupyterlab-ai-commands:get-notebook-content\",\n235:             {\"notebookPath\": file_path},\n236:         )\n237:         # execute_command wraps the command's return value under \"result\".\n238:         payload = res.get(\"result\", res) if isinstance(res, dict) else res\n239:         return payload[\"content\"]\n240: \n241:     normalized_path = normalize_filepath(file_path)\n242:     with open(normalized_path, \"r\", encoding=\"utf-8\") as f:\n243:         notebook_dict = json.load(f)\n244:         return notebook_dict\n245: \n246: \n247: async def read_cell(file_path: str, cell_id: str, include_outputs: bool = True) -> str:\n248:     \"\"\"Returns the notebook cell as a markdown string.\n249: \n250:     This function reads a specific cell from a Jupyter notebook file and converts\n251:     it to a markdown string. It uses the read_cell_json function to read the cell\n252:     and then converts it to markdown.\n253: \n254:     Args:\n255:         file_path:\n256:             The relative path to the notebook file on the filesystem.\n257:         cell_id:\n258:             The nbformat id of the cell.\n259:         include_outputs:\n260:             If True, cell outputs will be included in the markdown. Default is True.\n261: \n262:     Returns:\n263:         The cell content as a markdown string.\n264: \n265:     Raises:\n266:         LookupError: If no cell with the given ID is found.\n267:     \"\"\"\n268:     try:\n269:         # Resolve cell_id in case it's an index\n270:         resolved_cell_id = cell_id\n271:         cell, cell_index = await read_cell_json(file_path, resolved_cell_id)\n272:         cell_md = cell_to_md(cell, cell_index)\n273:         return cell_md\n274:     except Exception:\n275:         raise\n276: \n277: \n278: async def read_cell_json(file_path: str, cell_id: str) -> Tuple[Dict[str, Any], int]:\n279:     \"\"\"Returns the notebook cell as a JSON dictionary and its index.\n280: \n281:     This function reads a specific cell from a Jupyter notebook file and returns\n282:     both the cell content as a dictionary and the cell's index within the notebook.\n283: \n284:     Args:\n285:         file_path:\n286:             The relative path to the notebook file on the filesystem.\n287:         cell_id:\n288:             The nbformat id of the cell.\n289: \n290:     Returns:\n291:         A tuple containing:\n292:         - The cell as a dictionary\n293:         - The index of the cell in the notebook\n294: \n295:     Raises:\n296:         LookupError: If no cell with the given ID is found.\n297:     \"\"\"\n298:     try:\n299:         # Resolve cell_id in case it's an index\n\n(Showing lines 180-299 of 1659. Use offset=300 to continue.)\n</content>"
