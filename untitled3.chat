              "output": "<path>/workspaces/codespace/.pixi/envs/default/lib/python3.14/site-packages/jupyter_ai_tools/utils.py</path>\n<type>file</type>\n<content>\n1: import functools\n2: import inspect\n3: import os\n4: from pathlib import Path\n5: from typing import Dict, List, Optional\n6: from urllib.parse import unquote\n7: \n8: from jupyter_server.auth.identity import User\n9: from jupyter_server.serverapp import ServerApp\n10: from pycrdt import Awareness\n11: \n12: JSD_PRESENT = False\n13: try:\n14:     import jupyter_server_documents  # noqa: F401\n15: \n16:     JSD_PRESENT = True\n17: except ImportError:\n18:     pass\n19: \n20: \n21: def get_serverapp():\n22:     \"\"\"Returns the server app from the request context\"\"\"\n23: \n24:     server = ServerApp.instance()\n25:     return server\n26: \n27: \n28: # --- RTC availability -------------------------------------------------------\n29: # A minimal version of jupyterlab_chat's rtc_lib: is a real-time collaboration\n30: # provider actually active this session? \"installed\" is not \"enabled\", so we\n31: # check the extension manager (and honor jupyter_server_ydoc's disable_rtc\n32: # trait). When no provider is active, the tools fall back to driving the\n33: # JupyterLab frontend via jupyterlab-ai-commands.\n34: _RTC_PROVIDERS = (\"jupyter_server_documents\", \"jupyter_server_ydoc\")\n35: \n36: \n37: def rtc_available() -> bool:\n38:     \"\"\"Return True iff an RTC provider is enabled for the current session.\"\"\"\n39:     try:\n40:         serverapp = get_serverapp()\n41:         manager = serverapp.extension_manager\n42:     except Exception:\n43:         return False\n44: \n45:     for name in _RTC_PROVIDERS:\n46:         ext = manager.extensions.get(name)\n47:         if not (ext and getattr(ext, \"enabled\", False)):\n48:             continue\n49:         if name == \"jupyter_server_ydoc\":\n50:             # jupyter_server_ydoc can be turned off via YDocExtension.disable_rtc.\n51:             apps = getattr(manager, \"extension_apps\", {}) or {}\n52:             instances = apps.get(name)\n53:             app = next(iter(instances)) if instances else None\n54:             if app is not None and bool(getattr(app, \"disable_rtc\", False)):\n55:                 continue\n56:         return True\n57:     return False\n58: \n59: \n60: async def run_lab_command(command_id: str, args: Optional[Dict] = None) -> dict:\n61:     \"\"\"Execute a JupyterLab frontend command (via jupyterlab-commands-toolkit).\n62: \n63:     Used by the RTC-free tool implementations to drive jupyterlab-ai-commands.\n64:     \"\"\"\n65:     from jupyterlab_commands_toolkit.tools import execute_command\n66: \n67:     return await execute_command(command_id, args or {})\n68: \n69: \n70: def normalize_filepath(file_path: str) -> str:\n71:     \"\"\"\n72:     Normalizes a file path for Jupyter applications to return an absolute path.\n73: \n74:     Handles various input formats:\n75:     - Relative paths from current working directory\n76:     - URL-encoded relative paths (common in Jupyter contexts)\n77:     - Absolute paths (returned as-is after normalization)\n78: \n79:     Args:\n80:         file_path: Path in any of the supported formats\n81: \n82:     Returns:\n83:         Absolute path to the file\n84: \n85:     Example:\n86:         >>> normalize_filepath(\"notebooks/my%20notebook.ipynb\")\n87:         \"/current/working/dir/notebooks/my notebook.ipynb\"\n88:         >>> normalize_filepath(\"/absolute/path/file.ipynb\")\n89:         \"/absolute/path/file.ipynb\"\n90:         >>> normalize_filepath(\"relative/file.ipynb\")\n91:         \"/current/working/dir/relative/file.ipynb\"\n92:     \"\"\"\n93:     if not file_path or not file_path.strip():\n94:         raise ValueError(\"file_path cannot be empty\")\n95: \n96:     # URL decode the path in case it contains encoded characters\n97:     decoded_path = unquote(file_path)\n98: \n99:     # Convert to Path object for easier manipulation\n100:     path = Path(decoded_path)\n101: \n102:     # If already absolute, just normalize and return\n103:     if path.is_absolute():\n104:         return str(path.resolve())\n105: \n106:     # For relative paths, get the Jupyter server's root directory\n107:     try:\n108:         serverapp = get_serverapp()\n109:         root_dir = serverapp.root_dir\n110:     except Exception:\n111:         # Fallback to current working directory if server app is not available\n112:         root_dir = os.getcwd()\n113: \n114:     # Resolve relative path against the root directory\n115:     resolved_path = Path(root_dir) / path\n116:     return str(resolved_path.resolve())\n117: \n118: \n119: async def get_room(room_id: str):\n120:     \"\"\"Returns the yroom.\"\"\"\n121: \n122:     serverapp = get_serverapp()\n123:     if JSD_PRESENT:\n124:         manager = serverapp.web_app.settings[\"yroom_manager\"]\n125:         return manager.get_room(room_id) if manager.has_room(room_id) else None\n126:     else:\n127:         manager = serverapp.web_app.settings[\"jupyter_server_ydoc\"].ywebsocket_server\n128:         return await manager.get_room(room_id) if manager.room_exists(room_id) else None\n129: \n130: \n131: async def get_jupyter_ydoc(file_id: str):\n132:     \"\"\"Returns the notebook ydoc\n133: \n134:     Args:\n135:         file_id: The file ID for the document\n136: \n137:     Returns:\n138:         `YNotebook` ydoc for the notebook\n139:     \"\"\"\n140:     room_id = f\"json:notebook:{file_id}\"\n141:     yroom = await get_room(room_id)\n142:     if not yroom:\n143:         return\n144: \n145:     if JSD_PRESENT:\n146:         return await yroom.get_jupyter_ydoc()\n147:     else:\n148:         return yroom._document\n149: \n150: \n151: async def get_global_awareness() -> Optional[Awareness]:\n152:     \"\"\"Returns the global awareness object for JupyterLab collaboration.\n153: \n154:     Returns:\n155:         Awareness instance for global collaboration, or None if not available\n156:     \"\"\"\n157:     yroom = await get_room(\"JupyterLab:globalAwareness\")\n158:     if not yroom:\n159:         return None\n160: \n161:     if JSD_PRESENT:\n162:         return yroom.get_awareness()\n163:     else:\n164:         return yroom.awareness\n165: \n166: \n167: async def get_file_id(file_path: str) -> str:\n168:     \"\"\"Returns the file_id for the document\n169: \n170:     Args:\n171:         file_path:\n172:             absolute path to the document file\n173: \n174:     Returns:\n175:         The file ID of the document\n176:     \"\"\"\n177:     normalized_file_path = normalize_filepath(file_path)\n178: \n179:     serverapp = get_serverapp()\n180:     file_id_manager = serverapp.web_app.settings[\"file_id_manager\"]\n181:     file_id = file_id_manager.get_id(normalized_file_path)\n182: \n183:     return file_id\n184: \n185: \n186: def collaborative_tool(user: User):\n187:     \"\"\"\n188:     Decorator factory to enable collaborative awareness for toolkit functions.\n189: \n190:     This decorator automatically sets up user awareness in the global\n191:     and notebook-specific awareness systems when functions are called.\n192:     It enables real-time collaborative features by making the user's\n193:     presence visible to other users in the same Jupyter environment.\n194: \n195:     Args:\n196:         user: Optional user dictionary with user information. If None, no awareness is set.\n197:               Should contain keys like 'name', 'color', 'display_name', etc.\n198: \n199:     Returns:\n200:         Decorator function that wraps the target function with collaborative awareness.\n201: \n202:     Example:\n203:         >>> user_info = {\n204:         ...     \"name\": \"Alice\",\n205:         ...     \"color\": \"var(--jp-collaborator-color1)\",\n206:         ...     \"display_name\": \"Alice Smith\"\n207:         ... }\n208:         >>>\n209:         >>> @collaborative_tool(user=user_info)\n210:         ... async def my_notebook_tool(file_path: str, content: str):\n211:         ...     # Your tool implementation here\n212:         ...     return f\"Processed {file_path}\"\n213:     \"\"\"\n214: \n215:     def decorator(tool_func):\n216:         @functools.wraps(tool_func)\n217:         async def wrapper(*args, **kwargs):\n218:             # Skip awareness if no user provided\n219: \n220:             # Get serverapp for logging\n221:             try:\n222:                 serverapp = get_serverapp()\n223:                 logger = serverapp.log\n224:             except Exception:\n225:                 logger = None\n226: \n227:             # Extract file_path from tool function arguments for notebook-specific awareness\n228:             file_path = None\n229:             try:\n230:                 # Try to find file_path in kwargs first\n231:                 if \"file_path\" in kwargs:\n232:                     file_path = kwargs[\"file_path\"]\n233:                 else:\n234:                     # Try to find file_path in positional args by inspecting the function signature\n235:                     sig = inspect.signature(tool_func)\n236:                     param_names = list(sig.parameters.keys())\n237: \n238:                     # Look for file_path parameter\n239:                     if \"file_path\" in param_names and len(args) > param_names.index(\"file_path\"):\n240:                         file_path = args[param_names.index(\"file_path\")]\n241:             except Exception as e:\n242:                 # Log error in file_path detection\n243:                 if logger:\n244:                     logger.warning(f\"Error detecting file_path in collaborative_tool: {e}\")\n245: \n246:             # Set notebook-specific collaborative awareness if we have a file_path\n247:             if file_path and file_path.endswith(\".ipynb\"):\n248:                 try:\n249:                     file_id = await get_file_id(file_path)\n250:                     ydoc = await get_jupyter_ydoc(file_id)\n251: \n252:                     if ydoc:\n253:                         # Set the local user field in the notebook's awareness\n254:                         ydoc.awareness.set_local_state_field(\"user\", user)\n255:                 except Exception as e:\n256:                     # Log error but don't block tool execution\n257:                     if logger:\n258:                         logger.warning(\n259:                             f\"Error setting notebook awareness in collaborative_tool: {e}\"\n260:                         )\n261: \n262:             # Set global awareness\n263:             try:\n264:                 g_awareness = await get_global_awareness()\n265:                 if g_awareness:\n266:                     g_awareness.set_local_state(\n267:                         {\n268:                             \"user\": user,\n269:                             \"current\": file_path or \"\",\n270:                             \"documents\": [file_path] if file_path else [],\n271:                         }\n272:                     )\n273:             except Exception as e:\n274:                 # Log error but don't block tool execution\n275:                 if logger:\n276:                     logger.warning(f\"Error setting global awareness in collaborative_tool: {e}\")\n277: \n278:             # Execute the original tool function\n279:             return await tool_func(*args, **kwargs)\n280: \n281:         return wrapper\n282: \n283:     return decorator\n284: \n285: \n286: def notebook_json_to_md(notebook_json: dict, include_outputs: bool = True) -> str:\n287:     \"\"\"Converts a notebook json dict to markdown string using a custom format.\n288: \n289:     Args:\n290:         notebook_json: The notebook JSON dictionary\n291:         include_outputs: Whether to include cell outputs in the markdown. Default is True.\n292: \n293:     Returns:\n294:         Markdown string representation of the notebook\n295: \n296:     Example:\n297:         ```markdown\n298:         ```yaml\n299:         kernelspec:\n300:           display_name: Python 3\n301:           language: python\n302:           name: python3\n303:         ```\n304: \n305:         ### Cell 0\n306: \n307:         #### Metadata\n308:         ```yaml\n309:         id: 8f2c1a3b\n310:         type: code\n311:         execution_count: 1\n312:         ```\n313: \n314:         #### Source\n315:         ```python\n316:         print(\"Hello world\")\n317:         ```\n318: \n319:         #### Output\n320:         ```\n321:         Hello world\n322:         ```\n323:         ```\n324:     \"\"\"\n325:     # Extract notebook metadata\n326:     md_parts = []\n327: \n328:     # Add notebook metadata at the top\n329:     md_parts.append(metadata_to_md(notebook_json.get(\"metadata\", {})))\n330: \n331:     # Process all cells\n332:     for i, cell in enumerate(notebook_json.get(\"cells\", [])):\n333:         md_parts.append(cell_to_md(cell, index=i, include_outputs=include_outputs))\n334: \n335:     # Join all parts with double newlines\n336:     return \"\\n\\n\".join(md_parts)\n337: \n338: \n339: def metadata_to_md(metadata_json: Dict) -> str:\n340:     \"\"\"Converts notebook or cell metadata to markdown string in YAML format.\n341: \n342:     Args:\n343:         metadata_json: The metadata JSON dictionary\n344: \n345:     Returns:\n346:         Markdown string with YAML formatted metadata\n347:     \"\"\"\n348:     import yaml  # type: ignore[import-untyped]\n349: \n350:     yaml_str = yaml.dump(metadata_json, default_flow_style=False)\n351:     return f\"```yaml\\n{yaml_str}```\"\n352: \n353: \n354: def cell_to_md(cell_json: dict, index: int = 0, include_outputs: bool = True) -> str:\n355:     \"\"\"Converts notebook cell to markdown string.\n356: \n357:     Args:\n358:         cell_json: The cell JSON dictionary\n359:         index: Cell index number for the heading\n360:         include_outputs: Whether to include cell outputs in the markdown\n361: \n362:     Returns:\n363:         Markdown string representation of the cell\n364:     \"\"\"\n365:     md_parts = []\n366: \n367:     # Add cell heading with index\n368:     md_parts.append(f\"### Cell {index}\")\n369: \n370:     # Add metadata section\n371:     md_parts.append(\"#### Metadata\")\n372:     metadata = {\n373:         \"id\": cell_json.get(\"id\"),\n374:         \"type\": cell_json.get(\"cell_type\"),\n375:         \"execution_count\": cell_json.get(\"execution_count\"),\n376:     }\n377:     # Filter out None values\n378:     metadata = {k: v for k, v in metadata.items() if v is not None}\n379:     # Add any additional metadata from the cell\n380:     if \"metadata\" in cell_json:\n381:         for key, value in cell_json[\"metadata\"].items():\n382:             metadata[key] = value\n383: \n384:     md_parts.append(metadata_to_md(metadata))\n385: \n386:     # Add source section\n387:     md_parts.append(\"#### Source\")\n388:     source = \"\".join(cell_json.get(\"source\", []))\n389: \n390:     if cell_json.get(\"cell_type\") == \"code\":\n391:         # For code cells, use python code block\n392:         md_parts.append(f\"```python\\n{source}```\")\n393:     else:\n394:         # For markdown cells, use regular code block\n395:         md_parts.append(f\"```\\n{source}```\")\n396: \n397:     # Add output section if available and requested\n398:     if (\n399:         include_outputs\n400:         and cell_json.get(\"cell_type\") == \"code\"\n401:         and \"outputs\" in cell_json\n402:         and cell_json[\"outputs\"]\n403:     ):\n404:         md_parts.append(\"#### Output\")\n405:         md_parts.append(format_outputs(cell_json[\"outputs\"]))\n406: \n407:     return \"\\n\\n\".join(md_parts)\n408: \n409: \n410: def format_outputs(outputs: List) -> str:\n411:     \"\"\"Formats cell outputs into markdown.\n412: \n413:     Args:\n414:         outputs: List of cell output dictionaries\n415: \n416:     Returns:\n417:         Formatted markdown string of the outputs\n418:     \"\"\"\n419:     result = []\n420: \n421:     for output in outputs:\n422:         output_type = output.get(\"output_type\")\n423: \n424:         if output_type == \"stream\":\n425:             text = \"\".join(output.get(\"text\", []))\n426:             result.append(f\"```\\n{text}```\")\n427: \n428:         elif output_type == \"execute_result\" or output_type == \"display_data\":\n429:             data = output.get(\"data\", {})\n430: \n431:             # Handle text/plain output\n432:             if \"text/plain\" in data:\n433:                 text = \"\".join(data[\"text/plain\"])\n434:                 result.append(f\"```\\n{text}```\")\n435: \n436:             # TODO: Add other mime types\n437: \n438:         elif output_type == \"error\":\n439:             traceback = \"\\n\".join(output.get(\"traceback\", []))\n440:             result.append(f\"```\\n{traceback}```\")\n441: \n442:     return \"\\n\\n\".join(result)\n\n(End of file - total 442 lines)\n</content>",
