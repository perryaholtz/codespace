              "file_path": "exercises/16-nn-exercise.ipynb",
              "content": "# Chart the nn 2 output. `nn 2` has the best test accuracy on `train_small`,\n# so plot its decision boundary over the songs it was trained on.\n\nnn2_fit <- fit_nn(2, train_small)\n\ngrid <- crossing(\n    danceability = seq(0.2, 1, by = 0.01),\n    tempo = seq(60, 210, by = 1)\n)\n\ngrid |>\n    bind_cols(predict(nn2_fit, new_data = grid, type = 'prob')) |>\n    ggplot(aes(x = danceability, y = tempo)) +\n    geom_tile(aes(fill = .pred_edm)) +\n    geom_contour(aes(z = .pred_edm), breaks = 0.5, color = 'black') +\n    geom_point(data = train_small, size = 0.5, alpha = 0.4) +\n    scale_fill_gradient2(low = 'steelblue', mid = 'white', high = 'darkorange',\n                         midpoint = 0.5, limits = c(0, 1)) +\n    labs(fill = 'P(edm)', title = 'nn 2: decision boundary (trained on 100 songs)')\n",
              "cell_id": "ee43928c-a5dc-48a7-80bc-29071cdf87a9"
