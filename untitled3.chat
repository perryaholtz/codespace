            "raw_output": {
              "metadata": {
                "truncated": false,
                "exit": 0.0,
                "output": "############### notebooks/16-lecture-neural-networks.ipynb\n=== cell 2\nlibrary('tidymodels')\n\noptions(repr.plot.res = 250, repr.plot.height = 3, repr.plot.width = 5)\n\n=== cell 4\nnode <- function(x, b, w) plogis(b + w * x)   # plogis() is inv_logit()\n\nthree_nodes <- crossing(x = seq(-3, 3, by = 0.05), id = 1:3) |>\n    mutate(\n        b = c(0, -2, 3)[id],\n        w = c(1, 4, -2)[id],\n        y = node(x, b, w),\n        label = paste0('b = ', b, ', w = ', w)\n    )\n\nggplot(three_nodes, aes(x = x, y = y, color = label)) +\n    geom_line() +\n    labs(color = NULL)\n\n=== cell 7\nnodes <- tibble(\n    x     = c(1, 2, 2, 2, 3),\n    y     = c(0, 1, 0, -1, 0),\n    label = c('x', 'node 1', 'node 2', 'node 3', 'prediction')\n)\n\nedges <- tibble(\n    x    = c(1, 1, 1, 2, 2, 2),\n    y    = c(0, 0, 0, 1, 0, -1),\n    xend = c(2, 2, 2, 3, 3, 3),\n    yend = c(1, 0, -1, 0, 0, 0),\n    label = c('w1', 'w2', 'w3', 'c1', 'c2', 'c3')\n) |>\n    mutate(lx = (x + xend) / 2, ly = (y + yend) / 2 + 0.15)\n\nlayers <- tibble(\n    x = 1:3, y = 1.7,\n    label = c('input layer', 'hidden layer', 'output layer')\n)\n\nggplot() +\n    geom_segment(data = edges, aes(x = x, y = y, xend = xend, yend = yend), color = 'gray50') +\n    geom_text(data = edges, aes(x = lx, y = ly, label = label), size = 3, color = 'firebrick') +\n    geom_point(data = nodes, aes(x = x, y = y), size = 14, shape = 21, fill = 'white') +\n    geom_text(data = nodes, aes(x = x, y = y, label = label), size = 2) +\n    geom_text(data = layers, aes(x = x, y = y, label = label), fontface = 'bold', size = 3) +\n    xlim(0.6, 3.4) +\n    ylim(-1.5, 2) +\n    theme_void()\n\n=== cell 9\nset.seed(1)\nwavy <- tibble(x = runif(60, 0, 1)) |>\n    mutate(y = sin(2 * pi * x) + rnorm(n(), sd = 0.2))\n\np_wavy <- ggplot(wavy, aes(x = x, y = y)) + geom_point()\n\np_wavy\n\n=== cell 11\nset.seed(1)\n\nmod <- mlp(hidden_units = 3, epochs = 1000, penalty = 0) |>\n    set_mode('regression') |>\n    set_engine('nnet')\n\nmod_fit = mod |> fit(y ~ x, data = wavy)\n\ngrid_x <- tibble(x = seq(0, 1, by = 0.01))\n\npreds_3 <- predict(mod_fit, new_data = grid_x) |> bind_cols(grid_x)\n\np_wavy + geom_line(data = preds_3, aes(y = .pred), color = 'red')\n\n=== cell 16\nby_hand <- grid_x |>\n    mutate(\n        node1 = node(x, w['b->h1'], w['i1->h1']),\n        node2 = node(x, w['b->h2'], w['i1->h2']),\n        node3 = node(x, w['b->h3'], w['i1->h3']),\n        pred  = w['b->o'] + w['h1->o'] * node1 + w['h2->o'] * node2 + w['h3->o'] * node3\n    )\n\n# is it the same as predict()?\nall.equal(by_hand$pred, preds_3$.pred)\n\n=== cell 20\nggplot(parts, aes(x = x, y = value)) +\n    geom_line(aes(color = part)) +\n    geom_line(data = by_hand, aes(y = pred - w['b->o']), linewidth = 1, alpha = 0.5) +\n    labs(color = NULL, y = 'contribution')\n\n=== cell 23\nfit_wavy <- function(h) {\n    set.seed(1)\n    fit <- mlp(hidden_units = h, epochs = 1000, penalty = 0) |>\n        set_mode('regression') |>\n        set_engine('nnet', MaxNWts = 5000) |>\n        fit(y ~ x, data = wavy)\n\n    predict(fit, new_data = grid_x) |>\n        bind_cols(grid_x) |>\n        mutate(hidden_units = h)\n}\n\npreds_many <- map(c(1, 3, 10, 50), fit_wavy) |> list_rbind()\n\np_wavy +\n    geom_line(data = preds_many, aes(y = .pred), color = 'red') +\n    facet_wrap(~ hidden_units, labeller = label_both)\n\n=== cell 28\nrec <- recipe(grass_f ~ educ + year, data = gss_grass) |>\n    step_normalize(all_predictors())\n\nfit_grass <- function(h, data = gss_grass, epochs = 500) {\n    set.seed(1)\n    workflow() |>\n        add_recipe(rec) |>\n        add_model(\n            mlp(hidden_units = h, epochs = epochs, penalty = 0) |>\n                set_mode('classification') |>\n                set_engine('nnet', MaxNWts = 5000)\n        ) |>\n        fit(data = data)\n}\n\n=== cell 30\ngrid <- crossing(educ = 0:20, year = 1973:2024)\n\nplot_boundary <- function(fit, grid) {\n    preds <- fit |>\n        predict(new_data = grid, type = 'prob') |>\n        bind_cols(grid)\n\n    ggplot(preds, aes(x = year, y = educ)) +\n        geom_tile(aes(fill = .pred_yes)) +\n        geom_contour(aes(z = .pred_yes), breaks = 0.5, color = 'black') +\n        scale_fill_gradient2(low = 'steelblue', mid = 'white', high = 'darkorange',\n                             midpoint = 0.5, limits = c(0, 1))\n}\n\n=== cell 32\nnn_1 <- fit_grass(1)\n\nplot_boundary(nn_1, grid)\n\n=== cell 35\nplot_boundary(nn_3, grid)\n\n=== cell 36\nplot_boundary(nn_30, grid)\n\n=== cell 42\naccuracy_of <- function(fit, data) {\n    pred <- predict(fit, new_data = data, type = 'class')$.pred_class\n    mean(pred == data$grass_f)\n}\n\ncompare_models <- function(train_data) {\n    fits <- list(\n        logistic    = workflow() |> add_recipe(rec) |> add_model(logistic_reg()) |> fit(data = train_data),\n        forest      = rand_forest(trees = 200) |> set_mode('classification') |> set_engine('ranger') |>\n                          fit(grass_f ~ educ + year, data = train_data),\n        `nn 2`      = fit_grass(2, train_data, epochs = 1000),\n        `nn 10`     = fit_grass(10, train_data, epochs = 1000),\n        `nn 50`     = fit_grass(50, train_data, epochs = 1000)\n    )\n\n    tibble(\n        model = names(fits),\n        train_accuracy = map_dbl(fits, accuracy_of, data = train_data),\n        test_accuracy  = map_dbl(fits, accuracy_of, data = test)\n    )\n}\n\nset.seed(3)\ntrain_small <- train |> slice_sample(n = 100)\n\nresults <- bind_rows(\n    compare_models(train)       |> mutate(training_size = 'big'),\n    compare_models(train_small) |> mutate(training_size = 'small (n = 100)')\n)\n\nresults\n\n=== cell 44\nggplot(results, aes(x = model, y = test_accuracy, fill = training_size)) +\n    geom_col(position = 'dodge') +\n    coord_cartesian(ylim = c(0.5, 0.8)) +\n    labs(fill = NULL, y = 'accuracy on test set')\n\n############### notebooks/13-lecture-random-forest.ipynb\n=== cell 2\nlibrary('tidymodels')\n\noptions(repr.plot.res = 250, repr.plot.height = 3, repr.plot.width = 5)\n\n=== cell 6\ngrass_by_year <- gss_grass |>\n    group_by(year) |>\n    summarize(yes = mean(yes))\n\np_year <- ggplot(grass_by_year, aes(x = year, y = yes)) +\n    geom_point()\n\np_year\n\n=== cell 11\ngrid_year <- crossing(year = 1973:2024, educ = c(12, 16))\n\npreds_year <- fit_logit |>\n    predict(new_data = grid_year, type = 'prob') |>\n    bind_cols(grid_year)\n\np_year +\n    geom_line(data = preds_year, aes(y = .pred_yes, color = factor(educ))) +\n    labs(color = 'educ')\n\n=== cell 14\nset.seed(1)\n\nsix <- gss_grass |>\n    slice_sample(n = 6) |>\n    select(educ, year, grass_f)\n\npreds_six <- fit_logit |>\n    predict(new_data = six, type = 'prob') |>\n    bind_cols(six)\n\npreds_six\n\n=== cell 18\nfit_logit |>\n    predict(new_data = six, type = 'class') |>\n    bind_cols(preds_six |> select(.pred_yes, guess))\n\n=== cell 21\npreds_all <- fit_logit |>\n    predict(new_data = gss_grass, type = 'prob') |>\n    bind_cols(gss_grass)\n\npreds_all |>\n    mutate(\n        guess_50 = if_else(.pred_yes > 0.5, 'yes', 'no'),\n        guess_30 = if_else(.pred_yes > 0.3, 'yes', 'no')\n    ) |>\n    summarize(\n        share_yes_50 = mean(guess_50 == 'yes'),\n        accuracy_50  = mean(guess_50 == grass_f),\n        share_yes_30 = mean(guess_30 == 'yes'),\n        accuracy_30  = mean(guess_30 == grass_f)\n    )\n\n=== cell 27\ngrid <- crossing(educ = 0:20, year = 1973:2024)\n\ngrid |> head()\n\n=== cell 29\nplot_boundary <- function(fit, grid) {\n    preds <- fit |>\n        predict(new_data = grid, type = 'prob') |>\n        bind_cols(grid)\n\n    ggplot(preds, aes(x = year, y = educ)) +\n        geom_tile(aes(fill = .pred_yes)) +\n        geom_contour(aes(z = .pred_yes), breaks = 0.5, color = 'black') +\n        scale_fill_gradient2(low = 'steelblue', mid = 'white', high = 'darkorange',\n                             midpoint = 0.5, limits = c(0, 1))\n}\n\n=== cell 31\nactual_yes <- gss_grass |>\n    group_by(educ, year) |>\n    summarize(prop_yes = mean(yes), n = n(), .groups = 'drop') |>\n    filter(n >= 10)\n\np_actual <- ggplot(actual_yes, aes(x = year, y = educ)) +\n    geom_tile(aes(fill = prop_yes)) +\n    scale_fill_gradient2(low = 'steelblue', mid = 'white', high = 'darkorange',\n                         midpoint = 0.5, limits = c(0, 1)) +\n    labs(fill = 'proportion yes')\n\np_actual\n\n=== cell 33\nplot_boundary(fit_logit, grid)\n\n=== cell 36\na <- tidy(fit_logit)$estimate\n\nplot_boundary(fit_logit, grid) +\n    geom_abline(intercept = -a[1] / a[2], slope = -a[3] / a[2], color = 'red', linetype = 'dashed')\n\n=== cell 41\nfit_tree |>\n    extract_fit_engine() |>\n    rpart.plot::rpart.plot(roundint = FALSE, cex = 0.7)\n\n=== cell 43\nplot_boundary(fit_tree, grid)\n\n=== cell 48\nplot_boundary(fit_rf, grid)\n\n=== cell 52\naccuracy_of <- function(fit) {\n    pred <- predict(fit, new_data = gss_grass, type = 'class')$.pred_class\n    mean(pred == gss_grass$grass_f)\n}\n\ntibble(\n    model = c('always no', 'logistic', 'tree', 'forest'),\n    accuracy = c(mean(gss_grass$grass_f == 'no'),\n                 accuracy_of(fit_logit), accuracy_of(fit_tree), accuracy_of(fit_rf))\n)\n\n############### exercises/13-spotify-exercise.ipynb\n=== cell 2\nlibrary('tidymodels')\n\noptions(repr.plot.res = 250, repr.plot.height = 3, repr.plot.width = 5)\n\n=== cell 6\nggplot(songs, aes(x = danceability, y = tempo, color = genre)) + geom_point(alpha = 0.2, size = 0.5) + guides(color = guide_legend(override.aes = list(alpha = 1, size = 3)))\n\n=== cell 10\nfit_logit <- logistic_reg() |> fit(genre ~ danceability + tempo, data = songs)\n\npreds <- fit_logit |>\n    predict(new_data = songs, type = 'prob') |>\n    bind_cols(songs) |>\n    mutate(guess = if_else(.pred_edm > 0.5, 'edm', 'rap'))\n\npreds |> summarize(accuracy = mean(guess == genre))\n\n=== cell 14\ngrid <- crossing(danceability = seq(0.2, 1, by = 0.01), tempo = seq(60, 210, by = 1))\n\nplot_boundary <- function(fit, grid) {\n    preds <- fit |>\n        predict(new_data = grid, type = 'prob') |>\n        bind_cols(grid)\n\n    ggplot(preds, aes(x = danceability, y = tempo)) +\n        geom_tile(aes(fill = .pred_edm)) + \n        geom_contour(aes(z = .pred_edm), breaks = 0.5, color = 'black') +\n        scale_fill_gradient2(low = 'steelblue', mid = 'white', high = 'darkorange', \n                             midpoint = 0.5, limits = c(0, 1))\n    }\n\nplot_boundary(fit_logit, grid)\n    \n\n=== cell 22\nplot_boundary(fit_rf, grid)\n\nfit_rf |> \n    predict(new_data = songs, type = 'class') |>\n    bind_cols(songs) |>\n    summarize(accuracy = mean(.pred_class == genre))\n\n"
