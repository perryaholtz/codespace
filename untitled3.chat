              "output": "<path>/workspaces/codespace/.pixi/envs/default/lib/python3.14/site-packages/jupyter_server_mcp/mcp_server.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Simple MCP server for registering Python functions as tools.\"\"\"\n2: \n3: import asyncio\n4: import contextlib\n5: import errno\n6: import inspect\n7: import json\n8: import logging\n9: import os\n10: import socket\n11: import sys\n12: from collections.abc import Callable\n13: from functools import wraps\n14: from inspect import iscoroutinefunction, signature\n15: from typing import Any, Union, get_args, get_origin\n16: \n17: import uvicorn\n18: from fastmcp import FastMCP\n19: from fastmcp import settings as fastmcp_settings\n20: from fastmcp.server.middleware import Middleware\n21: from fastmcp.utilities.cli import log_server_banner\n22: from traitlets import Bool, Enum, Int, List, Unicode\n23: from traitlets import Union as UnionTrait\n24: from traitlets.config.configurable import LoggingConfigurable\n25: \n26: logger = logging.getLogger(__name__)\n27: \n28: \n29: class MCPServerPortError(RuntimeError):\n30:     \"\"\"Raised when the configured MCP server port cannot be bound.\"\"\"\n31: \n32: \n33: class _EmbeddedUvicornServer(uvicorn.Server):\n34:     \"\"\"Uvicorn server variant that leaves process signals to Jupyter Server.\"\"\"\n35: \n36:     def __init__(self, config: uvicorn.Config, *, on_startup_complete=None):\n37:         super().__init__(config)\n38:         self._on_startup_complete = on_startup_complete\n39: \n40:     @contextlib.contextmanager\n41:     def capture_signals(self):\n42:         \"\"\"Do not install SIGINT/SIGTERM handlers for embedded servers.\"\"\"\n43:         yield\n44: \n45:     async def startup(self, sockets=None):\n46:         \"\"\"Run the default startup, then notify any listener that we are bound.\"\"\"\n47:         await super().startup(sockets=sockets)\n48:         if self._on_startup_complete is not None:\n49:             self._on_startup_complete(self)\n50: \n51: \n52: def _ensure_port_available(host: str, port: int) -> None:\n53:     \"\"\"Check whether Uvicorn will be able to bind to the configured address.\"\"\"\n54:     if port == 0:\n55:         return\n56: \n57:     try:\n58:         addr_infos = socket.getaddrinfo(\n59:             host or None,\n60:             port,\n61:             type=socket.SOCK_STREAM,\n62:             flags=socket.AI_PASSIVE,\n63:         )\n64:         reuse_address = os.name == \"posix\" and sys.platform != \"cygwin\"\n65:         checked_any_address = False\n66:         for family, socktype, proto, _canonname, sockaddr in set(addr_infos):\n67:             try:\n68:                 sock = socket.socket(family, socktype, proto)\n69:             except OSError:\n70:                 continue\n71: \n72:             try:\n73:                 if reuse_address:\n74:                     sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, True)\n75:                 if family == socket.AF_INET6 and hasattr(socket, \"IPPROTO_IPV6\"):\n76:                     sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, True)\n77:                 sock.bind(sockaddr)\n78:                 checked_any_address = True\n79:             except OSError as exc:\n80:                 if exc.errno == errno.EADDRNOTAVAIL:\n81:                     continue\n82:                 raise\n83:             finally:\n84:                 sock.close()\n85: \n86:         if not checked_any_address:\n87:             msg = f\"could not bind on any address from {addr_infos}\"\n88:             raise OSError(msg)\n89:     except OSError as exc:\n90:         msg = (\n91:             f\"Cannot start MCP server on {host}:{port}: {exc.strerror or exc}. \"\n92:             \"Configure another MCP port with \"\n93:             \"c.MCPExtensionApp.mcp_port = <port> or \"\n94:             \"--MCPExtensionApp.mcp_port=<port>.\"\n95:         )\n96:         raise MCPServerPortError(msg) from exc\n97: \n98: \n99: def _is_dict_compatible_annotation(annotation) -> bool:\n100:     \"\"\"Check if an annotation expects dict values that can be JSON-converted.\"\"\"\n101:     # Direct dict annotation\n102:     if annotation is dict:\n103:         return True\n104: \n105:     # Union types: Optional[dict], Union[dict, None], dict | None\n106:     origin = get_origin(annotation)\n107:     if origin is Union or (\n108:         hasattr(annotation, \"__class__\")\n109:         and annotation.__class__.__name__ == \"UnionType\"\n110:     ):\n111:         args = get_args(annotation)\n112:         return dict in args\n113: \n114:     # Typed dict annotations: Dict[K, V], dict[str, Any]\n115:     return bool(hasattr(annotation, \"__origin__\") and annotation.__origin__ is dict)\n116: \n117: \n118: def _wrap_with_json_conversion(func: Callable) -> Callable:\n119:     \"\"\"\n120:     Wrapper that automatically converts JSON string arguments to dictionaries.\n121: \n122:     This addresses the common issue where MCP clients pass dictionary arguments\n123:     as JSON strings instead of structured objects. The wrapper inspects the\n124:     function signature and attempts JSON parsing for parameters annotated as\n125:     dict types when they are received as strings.\n126: \n127:     Additionally, this function modifies the type annotations to accept Union[dict, str]\n128:     for dict parameters to allow Pydantic validation to pass.\n129: \n130:     This conversion is always applied to all registered tools to ensure compatibility\n131:     with various MCP clients that may serialize dict parameters differently.\n132: \n133:     Args:\n134:         func: The function to wrap\n135: \n136:     Returns:\n137:         Wrapped function that handles JSON string conversion with modified annotations\n138:     \"\"\"\n139:     sig = signature(func)\n140: \n141:     def _should_convert_to_dict(annotation, value):\n142:         \"\"\"Check if a parameter should be converted from JSON string to dict.\"\"\"\n143:         return isinstance(value, str) and _is_dict_compatible_annotation(annotation)\n144: \n145:     def _add_string_to_annotation(annotation):\n146:         \"\"\"Modify annotation to also accept strings for dict types.\"\"\"\n147:         # Direct dict annotation -> dict | str\n148:         if annotation is dict:\n149:             return dict | str\n150: \n151:         # Union types: add str to existing union\n152:         origin = get_origin(annotation)\n153:         if origin is Union:\n154:             args = get_args(annotation)\n155:             if dict in args and str not in args:\n156:                 return Union[(*tuple(args), str)]\n157:             return annotation\n158: \n159:         # New Python 3.10+ union syntax: dict | None\n160:         if (\n161:             hasattr(annotation, \"__class__\")\n162:             and annotation.__class__.__name__ == \"UnionType\"\n163:         ):\n164:             args = get_args(annotation)\n165:             if dict in args and str not in args:\n166:                 # Reconstruct the union with str added\n167:                 new_args = (*tuple(args), str)\n168:                 # Create new union type\n169:                 result = new_args[0]\n170:                 for arg in new_args[1:]:\n171:                     result = result | arg\n172:                 return result\n173:             return annotation\n174: \n175:         # Typed dict annotations -> annotation | str\n176:         if hasattr(annotation, \"__origin__\") and annotation.__origin__ is dict:\n177:             return annotation | str\n178: \n179:         return annotation\n180: \n181:     # Create new annotations that accept strings for dict parameters\n182:     new_annotations = {}\n183:     for param_name, param in sig.parameters.items():\n184:         if param.annotation != inspect.Parameter.empty:\n185:             new_annotations[param_name] = _add_string_to_annotation(param.annotation)\n186:         else:\n187:             new_annotations[param_name] = param.annotation\n188: \n189:     # Keep the return annotation unchanged\n190:     if hasattr(func, \"__annotations__\") and \"return\" in func.__annotations__:\n191:         new_annotations[\"return\"] = func.__annotations__[\"return\"]\n192: \n193:     if iscoroutinefunction(func):\n194: \n195:         @wraps(func)\n196:         async def async_wrapper(*args, **kwargs):\n197:             # Convert keyword arguments that should be dicts but are strings\n198:             converted_kwargs = {}\n199:             for param_name, param_value in kwargs.items():\n200:                 if param_name in sig.parameters:\n201:                     param = sig.parameters[param_name]\n202:                     if _should_convert_to_dict(param.annotation, param_value):\n203:                         try:\n204:                             converted_kwargs[param_name] = json.loads(param_value)\n205:                             logger.debug(\n206:                                 f\"Converted JSON string to dict for parameter '{param_name}': {param_value}\"\n207:                             )\n208:                         except json.JSONDecodeError:\n209:                             # If it's not valid JSON, pass the string as-is\n210:                             converted_kwargs[param_name] = param_value\n211:                     else:\n212:                         converted_kwargs[param_name] = param_value\n213:                 else:\n214:                     converted_kwargs[param_name] = param_value\n215: \n216:             return await func(*args, **converted_kwargs)\n217: \n218:         # Set the modified annotations on the wrapper\n219:         async_wrapper.__annotations__ = new_annotations\n220:         return async_wrapper\n221: \n222:     @wraps(func)\n223:     def sync_wrapper(*args, **kwargs):\n224:         # Convert keyword arguments that should be dicts but are strings\n225:         converted_kwargs = {}\n226:         for param_name, param_value in kwargs.items():\n227:             if param_name in sig.parameters:\n228:                 param = sig.parameters[param_name]\n229:                 if _should_convert_to_dict(param.annotation, param_value):\n230:                     try:\n231:                         converted_kwargs[param_name] = json.loads(param_value)\n232:                         logger.debug(\n233:                             f\"Converted JSON string to dict for parameter '{param_name}': {param_value}\"\n234:                         )\n235:                     except json.JSONDecodeError:\n236:                         # If it's not valid JSON, pass the string as-is\n237:                         converted_kwargs[param_name] = param_value\n238:                 else:\n239:                     converted_kwargs[param_name] = param_value\n240:             else:\n241:                 converted_kwargs[param_name] = param_value\n242: \n243:         return func(*args, **converted_kwargs)\n244: \n245:     # Set the modified annotations on the wrapper\n246:     sync_wrapper.__annotations__ = new_annotations\n247:     return sync_wrapper\n248: \n249: \n250: class MCPServer(LoggingConfigurable):\n251:     \"\"\"Simple MCP server that allows registering Python functions as tools.\"\"\"\n252: \n253:     # Configurable traits\n254:     name = Unicode(\n255:         default_value=\"Jupyter MCP Server\", help=\"Name for the MCP server\"\n256:     ).tag(config=True)\n257: \n258:     port = Int(\n259:         default_value=3001,\n260:         help=(\n261:             \"Port for the MCP server to listen on. \"\n262:             \"Defaults to 3001. Set to 0 to ask the OS to pick a free port \u2014 \"\n263:             \"useful when running multiple servers side by side.\"\n264:         ),\n265:     ).tag(config=True)\n266: \n267:     host = Unicode(\n268:         default_value=\"localhost\", help=\"Host for the MCP server to listen on\"\n269:     ).tag(config=True)\n270: \n271:     host_origin_protection = UnionTrait(\n272:         [Bool(), Enum([\"auto\"])],\n273:         default_value=True,\n274:         help=(\n275:             \"Validate the ``Host`` and ``Origin`` headers of incoming requests \"\n276:             \"to protect the MCP server against DNS-rebinding and cross-origin \"\n277:             \"attacks (the MCP server runs on its own port, outside Jupyter \"\n278:             \"Server's token/XSRF protection). \"\n279:             \"``True`` (default) always validates; ``'auto'`` validates only \"\n280:             \"when bound to a loopback address; ``False`` disables validation \"\n281:             \"and is strongly discouraged. The loopback hosts (127.0.0.1, \"\n282:             \"localhost, ::1) and the configured bind ``host`` are always \"\n283:             \"trusted. Requests with a foreign ``Origin`` are rejected with 403 \"\n284:             \"and those with a foreign ``Host`` with 421, before reaching any \"\n285:             \"registered tool.\"\n286:         ),\n287:     ).tag(config=True)\n288: \n289:     allowed_hosts = List(\n290:         trait=Unicode(),\n291:         default_value=[],\n292:         help=(\n293:             \"Additional ``Host`` header values to accept, beyond the loopback \"\n294:             \"defaults (127.0.0.1, localhost, ::1) and the configured bind \"\n295:             \"``host``. Set this for reverse-proxy or non-loopback deployments. \"\n296:             \"Only used when ``host_origin_protection`` is enabled.\"\n297:         ),\n298:     ).tag(config=True)\n299: \n300:     allowed_origins = List(\n301:         trait=Unicode(),\n302:         default_value=[],\n303:         help=(\n304:             \"Additional browser ``Origin`` values to trust, beyond the loopback \"\n305:             \"defaults. Set this when the MCP server is legitimately reached \"\n306:             \"from a non-loopback web origin. \"\n307:             \"Only used when ``host_origin_protection`` is enabled.\"\n308:         ),\n309:     ).tag(config=True)\n310: \n311:     def __init__(self, **kwargs):\n312:         \"\"\"Initialize the MCP server.\n313: \n314:         Args:\n315:             **kwargs: Configuration parameters\n316:         \"\"\"\n317:         super().__init__(**kwargs)\n318: \n319:         # Initialize FastMCP and tools registry\n320:         self.mcp = FastMCP(self.name)\n321:         self._registered_tools = {}\n322:         self._uvicorn_server: uvicorn.Server | None = None\n323:         self._bound_event: asyncio.Event = asyncio.Event()\n324:         self.log.info(\n325:             f\"Initialized MCP server '{self.name}' on {self.host}:{self.port}\"\n326:         )\n327: \n328:     def add_middleware(self, middleware: Middleware) -> None:\n329:         \"\"\"Add a FastMCP middleware, run around every request to this server.\"\"\"\n330:         self.mcp.add_middleware(middleware)\n331: \n332:     def register_tool(\n333:         self,\n334:         func: Callable,\n335:         name: str | None = None,\n336:         description: str | None = None,\n337:     ):\n338:         \"\"\"Register a Python function as an MCP tool.\n339: \n340:         Args:\n341:             func: Python function to register\n342:             name: Optional tool name (defaults to function name)\n343:             description: Optional tool description (defaults to function\n344:                 docstring)\n345:         \"\"\"\n346:         tool_name = name or func.__name__\n347:         tool_description = description or func.__doc__ or f\"Tool: {tool_name}\"\n348: \n349:         self.log.info(f\"Registering tool: {tool_name}\")\n350:         self.log.debug(\n351:             f\"Tool details - Name: {tool_name}, \"\n352:             f\"Description: {tool_description}, Async: {iscoroutinefunction(func)}\"\n353:         )\n354: \n355:         # Apply auto-conversion wrapper (always enabled)\n356:         registered_func = _wrap_with_json_conversion(func)\n357:         self.log.debug(f\"Applied JSON argument auto-conversion wrapper to {tool_name}\")\n358: \n359:         self.mcp.tool(registered_func)\n360: \n361:         # Keep track for listing\n362:         self._registered_tools[tool_name] = {\n363:             \"name\": tool_name,\n364:             \"description\": tool_description,\n365:             \"function\": func,\n366:             \"is_async\": iscoroutinefunction(func),\n367:         }\n368: \n369:     def register_tools(self, tools: list[Callable] | dict[str, Callable]):\n370:         \"\"\"Register multiple Python functions as MCP tools.\n371: \n372:         Args:\n373:             tools: List of functions or dict mapping names to functions\n374:         \"\"\"\n375:         if isinstance(tools, list):\n376:             for func in tools:\n377:                 self.register_tool(func)\n378:         elif isinstance(tools, dict):\n379:             for name, func in tools.items():\n380:                 self.register_tool(func, name=name)\n381:         else:\n382:             msg = \"tools must be a list of functions or dict mapping names to functions\"\n383:             raise ValueError(msg)  # noqa: TRY004\n384: \n385:     def list_tools(self) -> list[dict[str, Any]]:\n386:         \"\"\"List all registered tools.\"\"\"\n387:         return [\n388:             {\"name\": tool[\"name\"], \"description\": tool[\"description\"]}\n389:             for tool in self._registered_tools.values()\n390:         ]\n391: \n392:     def get_tool_info(self, tool_name: str) -> dict[str, Any] | None:\n393:         \"\"\"Get information about a specific tool.\"\"\"\n394:         return self._registered_tools.get(tool_name)\n395: \n396:     def _capture_bound_port(self, server: uvicorn.Server) -> None:\n397:         \"\"\"Record the actual listening port once uvicorn has bound its sockets.\n398: \n399:         When uvicorn is given a hostname like ``localhost`` with port 0, it\n400:         binds an IPv4 and an IPv6 socket, each with its own ephemeral port.\n401:         Clients resolving ``localhost`` typically try IPv4 first, so prefer\n402:         the IPv4 port when both families are present.\n403:         \"\"\"\n404:         bound_port: int | None = None\n405:         if server.servers:\n406:             for uv_server in server.servers:\n407:                 for sock in uv_server.sockets:\n408:                     sockname = sock.getsockname()\n409:                     if not (isinstance(sockname, tuple) and len(sockname) >= 2):\n410:                         continue\n411:                     family = getattr(sock, \"family\", None)\n412:                     port = int(sockname[1])\n413:                     if family == socket.AF_INET:\n414:                         bound_port = port\n415:                         break\n416:                     if bound_port is None:\n417:                         bound_port = port\n418:                 if bound_port is not None and (\n419:                     getattr(uv_server.sockets[0], \"family\", None) == socket.AF_INET\n420:                 ):\n421:                     break\n422:         if bound_port is not None:\n423:             self.port = bound_port\n424:         self._bound_event.set()\n425: \n426:     async def _run_http_async_without_signals(self, host: str, port: int) -> None:\n427:         \"\"\"Run FastMCP over HTTP without taking over process signal handlers.\"\"\"\n428:         transport = \"http\"\n429:         app = self.mcp.http_app(\n430:             transport=transport,\n431:             host_origin_protection=self.host_origin_protection,\n432:             allowed_hosts=list(self.allowed_hosts) or None,\n433:             allowed_origins=list(self.allowed_origins) or None,\n434:         )\n435: \n436:         log_server_banner(server=self.mcp)\n437: \n438:         config = uvicorn.Config(\n439:             app,\n440:             host=host,\n441:             port=port,\n442:             timeout_graceful_shutdown=2,\n443:             lifespan=\"on\",\n444:             ws=\"websockets-sansio\",\n445:             log_level=fastmcp_settings.log_level.lower(),\n446:         )\n447:         server = _EmbeddedUvicornServer(\n448:             config, on_startup_complete=self._capture_bound_port\n449:         )\n450:         self._uvicorn_server = server\n451:         path = getattr(app.state, \"path\", \"\").lstrip(\"/\")\n452:         self.log.info(\n453:             f\"Starting MCP server {self.name!r} with transport \"\n454:             f\"{transport!r} on http://{host}:{port}/{path}\"\n455:         )\n456: \n457:         try:\n458:             await server.serve()\n459:         except asyncio.CancelledError:\n460:             server.should_exit = True\n461:             if getattr(server, \"started\", False):\n462:                 with contextlib.suppress(Exception, asyncio.CancelledError):\n463:                     await server.shutdown()\n464:             raise\n465:         finally:\n466:             if self._uvicorn_server is server:\n467:                 self._uvicorn_server = None\n468: \n469:     async def stop_server(self) -> None:\n470:         \"\"\"Request a graceful MCP HTTP server shutdown.\"\"\"\n471:         if self._uvicorn_server is not None:\n472:             self._uvicorn_server.should_exit = True\n473: \n474:     async def wait_until_bound(self, timeout: float | None = None) -> None:\n475:         \"\"\"Block until the HTTP server has finished binding its listening port.\"\"\"\n476:         if timeout is None:\n477:             await self._bound_event.wait()\n478:         else:\n479:             await asyncio.wait_for(self._bound_event.wait(), timeout=timeout)\n480: \n481:     async def start_server(self, host: str | None = None):\n482:         \"\"\"Start the MCP server on the specified host and port.\"\"\"\n483:         server_host = host or self.host\n484:         _ensure_port_available(server_host, self.port)\n485: \n486:         self.log.info(f\"Registered tools: {list(self._registered_tools.keys())}\")\n487: \n488:         # Reset (don't replace) the event so existing waiters stay subscribed.\n489:         self._bound_event.clear()\n490:         await self._run_http_async_without_signals(host=server_host, port=self.port)\n\n(End of file - total 490 lines)\n</content>",
              "metadata": {
