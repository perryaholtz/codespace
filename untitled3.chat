                "preview": "import asyncio\nimport time\nimport uuid\nfrom contextvars import ContextVar\nfrom typing import Any, Dict, Optional\n\nfrom jupyter_server.serverapp import ServerApp\n\n# Store for pending command results\npending_requests: Dict[str, Dict[str, Any]] = {}\n\n# The id of the web client that should execute the emitted commands,\n# or None to have all connected web clients execute them\ntarget_client_id: ContextVar[Optional[str]] = ContextVar(\n    \"target_client_id\", default=None\n)\n\n# Tools list for jupyter-server-mcp entrypoint discovery\nTOOLS = [\n    \"jupyterlab_commands_toolkit.tools:list_all_commands\",",
                "loaded": [],
                "truncated": false,
                "display": {
                  "path": "/workspaces/codespace/.pixi/envs/default/lib/python3.14/site-packages/jupyterlab_commands_toolkit/tools.py",
                  "truncated": false,
                  "lineEnd": 184.0,
                  "text": "import asyncio\nimport time\nimport uuid\nfrom contextvars import ContextVar\nfrom typing import Any, Dict, Optional\n\nfrom jupyter_server.serverapp import ServerApp\n\n# Store for pending command results\npending_requests: Dict[str, Dict[str, Any]] = {}\n\n# The id of the web client that should execute the emitted commands,\n# or None to have all connected web clients execute them\ntarget_client_id: ContextVar[Optional[str]] = ContextVar(\n    \"target_client_id\", default=None\n)\n\n# Tools list for jupyter-server-mcp entrypoint discovery\nTOOLS = [\n    \"jupyterlab_commands_toolkit.tools:list_all_commands\",\n    \"jupyterlab_commands_toolkit.tools:execute_command\",\n]\n\n\ndef emit(data, wait_for_result=False):\n    \"\"\"\n    Emit an event to the frontend with optional result waiting.\n\n    Args:\n        data: Event data to emit\n        wait_for_result: Whether to add a request ID for result tracking\n\n    Returns:\n        str: Request ID if wait_for_result is True, None otherwise\n    \"\"\"\n    server = ServerApp.instance()\n\n    client_id = target_client_id.get()\n    if client_id is not None:\n        data.setdefault(\"client_id\", client_id)\n\n    # Add request ID if waiting for result\n    request_id = None\n    if wait_for_result:\n        request_id = str(uuid.uuid4())\n        data[\"requestId\"] = request_id\n        pending_requests[request_id] = {\n            \"timestamp\": time.time(),\n            \"data\": data,\n            \"result\": None,\n            \"completed\": False,\n            \"future\": asyncio.get_running_loop().create_future(),\n        }\n\n    server.io_loop.call_later(\n        0.1,\n        server.event_logger.emit,\n        schema_id=\"https://events.jupyter.org/jupyterlab_command_toolkit/lab_command/v1\",\n        data=data,\n    )\n\n    return request_id\n\n\nasync def emit_and_wait_for_result(data, timeout=10.0):\n    \"\"\"\n    Emit a command and wait for its result.\n\n    Args:\n        data: Command data to emit\n        timeout: How long to wait for a result (seconds)\n\n    Returns:\n        dict: Command result from the frontend\n    \"\"\"\n    request_id = emit(data, wait_for_result=True)\n\n    try:\n        future = pending_requests[request_id][\"future\"]\n        result = await asyncio.wait_for(future, timeout=timeout)\n        return result\n    except asyncio.TimeoutError:\n        return {\n            \"success\": False,\n            \"error\": f\"Command timed out after {timeout} seconds\",\n            \"request_id\": request_id,\n        }\n    finally:\n        pending_requests.pop(request_id, None)\n\n\ndef handle_command_result(event_data):\n    \"\"\"Handle incoming command results from the frontend.\"\"\"\n    request_id = event_data.get(\"requestId\")\n    if request_id and request_id in pending_requests:\n        request_info = pending_requests[request_id]\n        request_info[\"result\"] = event_data\n        request_info[\"completed\"] = True\n\n        future = request_info.get(\"future\")\n        if future and not future.done():\n            future.set_result(event_data)\n\n\nasync def list_all_commands(query: Optional[str] = None) -> dict:\n    \"\"\"\n    Retrieve a list of all available JupyterLab commands.\n\n    This function emits a request to the JupyterLab frontend to retrieve all\n    registered commands in the application. It waits for the response and\n    returns the complete list of available commands with their metadata.\n\n    Args:\n        query (Optional[str], optional): An optional search query to filter commands.\n                                        When provided, only commands whose ID, label,\n                                        caption, or description contain the query string\n                                        (case-insensitive) will be returned. If None or\n                                        omitted, all commands will be returned.\n                                        Defaults to None.\n\n    Returns:\n        dict: A dictionary containing the command list response from JupyterLab.\n              The structure typically includes:\n              - success (bool): Whether the operation succeeded\n              - commandCount (int): Number of commands returned\n              - commands (list): List of available command objects, each with:\n                  - id (str): The command identifier\n                  - label (str, optional): Human-readable command label\n                  - caption (str, optional): Short description\n                  - description (str, optional): Detailed usage information\n                  - args (dict, optional): Command argument schema\n              - error (str, optional): Error message if the operation failed\n\n    Examples:\n        >>> # Get all commands\n        >>> await list_all_commands()\n        {'success': True, 'commandCount': 150, 'commands': [...]}\n\n        >>> # Filter commands by query\n        >>> await list_all_commands(query=\"notebook\")\n        {'success': True, 'commandCount': 25, 'commands': [...]}\n    \"\"\"\n    args = {}\n    if query is not None:\n        args[\"query\"] = query\n\n    return await emit_and_wait_for_result(\n        {\"name\": \"jupyterlab-commands-toolkit:list-all-commands\", \"args\": args}\n    )\n\n\nasync def execute_command(command_id: str, args: Optional[dict] = None) -> dict:\n    \"\"\"\n    Execute a JupyterLab command with optional arguments.\n\n    This function sends a command execution request to the JupyterLab frontend\n    and waits for the result. The command is identified by its unique command_id\n    and can be parameterized with optional arguments.\n\n    Args:\n        command_id (str): The unique identifier of the JupyterLab command to execute.\n                         This should be a valid command ID registered in JupyterLab.\n        args (Optional[dict], optional): A dictionary of arguments to pass to the\n                                       command. Defaults to None, which is converted\n                                       to an empty dictionary.\n\n    Returns:\n        dict: A dictionary containing the command execution response from JupyterLab.\n              The structure typically includes:\n              - success (bool): Whether the command executed successfully\n              - result (any): The return value from the executed command\n              - error (str, optional): Error message if the command failed\n              - request_id (str): The unique identifier for this request\n\n    Examples:\n        >>> await execute_command(\"application:toggle-left-area\")\n        {'success': True, 'result': None}\n\n        >>> await execute_command(\"docmanager:open\", {\"path\": \"notebook.ipynb\"})\n        {'success': True, 'result': 'opened'}\n    \"\"\"\n    if args is None:\n        args = {}\n    return await emit_and_wait_for_result({\"name\": command_id, \"args\": args})",
                  "lineStart": 1.0,
                  "type": "file",
                  "totalLines": 184.0
                }
              },
              "output": "<path>/workspaces/codespace/.pixi/envs/default/lib/python3.14/site-packages/jupyterlab_commands_toolkit/tools.py</path>\n<type>file</type>\n<content>\n1: import asyncio\n2: import time\n3: import uuid\n4: from contextvars import ContextVar\n5: from typing import Any, Dict, Optional\n6: \n7: from jupyter_server.serverapp import ServerApp\n8: \n9: # Store for pending command results\n10: pending_requests: Dict[str, Dict[str, Any]] = {}\n11: \n12: # The id of the web client that should execute the emitted commands,\n13: # or None to have all connected web clients execute them\n14: target_client_id: ContextVar[Optional[str]] = ContextVar(\n15:     \"target_client_id\", default=None\n16: )\n17: \n18: # Tools list for jupyter-server-mcp entrypoint discovery\n19: TOOLS = [\n20:     \"jupyterlab_commands_toolkit.tools:list_all_commands\",\n21:     \"jupyterlab_commands_toolkit.tools:execute_command\",\n22: ]\n23: \n24: \n25: def emit(data, wait_for_result=False):\n26:     \"\"\"\n27:     Emit an event to the frontend with optional result waiting.\n28: \n29:     Args:\n30:         data: Event data to emit\n31:         wait_for_result: Whether to add a request ID for result tracking\n32: \n33:     Returns:\n34:         str: Request ID if wait_for_result is True, None otherwise\n35:     \"\"\"\n36:     server = ServerApp.instance()\n37: \n38:     client_id = target_client_id.get()\n39:     if client_id is not None:\n40:         data.setdefault(\"client_id\", client_id)\n41: \n42:     # Add request ID if waiting for result\n43:     request_id = None\n44:     if wait_for_result:\n45:         request_id = str(uuid.uuid4())\n46:         data[\"requestId\"] = request_id\n47:         pending_requests[request_id] = {\n48:             \"timestamp\": time.time(),\n49:             \"data\": data,\n50:             \"result\": None,\n51:             \"completed\": False,\n52:             \"future\": asyncio.get_running_loop().create_future(),\n53:         }\n54: \n55:     server.io_loop.call_later(\n56:         0.1,\n57:         server.event_logger.emit,\n58:         schema_id=\"https://events.jupyter.org/jupyterlab_command_toolkit/lab_command/v1\",\n59:         data=data,\n60:     )\n61: \n62:     return request_id\n63: \n64: \n65: async def emit_and_wait_for_result(data, timeout=10.0):\n66:     \"\"\"\n67:     Emit a command and wait for its result.\n68: \n69:     Args:\n70:         data: Command data to emit\n71:         timeout: How long to wait for a result (seconds)\n72: \n73:     Returns:\n74:         dict: Command result from the frontend\n75:     \"\"\"\n76:     request_id = emit(data, wait_for_result=True)\n77: \n78:     try:\n79:         future = pending_requests[request_id][\"future\"]\n80:         result = await asyncio.wait_for(future, timeout=timeout)\n81:         return result\n82:     except asyncio.TimeoutError:\n83:         return {\n84:             \"success\": False,\n85:             \"error\": f\"Command timed out after {timeout} seconds\",\n86:             \"request_id\": request_id,\n87:         }\n88:     finally:\n89:         pending_requests.pop(request_id, None)\n90: \n91: \n92: def handle_command_result(event_data):\n93:     \"\"\"Handle incoming command results from the frontend.\"\"\"\n94:     request_id = event_data.get(\"requestId\")\n95:     if request_id and request_id in pending_requests:\n96:         request_info = pending_requests[request_id]\n97:         request_info[\"result\"] = event_data\n98:         request_info[\"completed\"] = True\n99: \n100:         future = request_info.get(\"future\")\n101:         if future and not future.done():\n102:             future.set_result(event_data)\n103: \n104: \n105: async def list_all_commands(query: Optional[str] = None) -> dict:\n106:     \"\"\"\n107:     Retrieve a list of all available JupyterLab commands.\n108: \n109:     This function emits a request to the JupyterLab frontend to retrieve all\n110:     registered commands in the application. It waits for the response and\n111:     returns the complete list of available commands with their metadata.\n112: \n113:     Args:\n114:         query (Optional[str], optional): An optional search query to filter commands.\n115:                                         When provided, only commands whose ID, label,\n116:                                         caption, or description contain the query string\n117:                                         (case-insensitive) will be returned. If None or\n118:                                         omitted, all commands will be returned.\n119:                                         Defaults to None.\n120: \n121:     Returns:\n122:         dict: A dictionary containing the command list response from JupyterLab.\n123:               The structure typically includes:\n124:               - success (bool): Whether the operation succeeded\n125:               - commandCount (int): Number of commands returned\n126:               - commands (list): List of available command objects, each with:\n127:                   - id (str): The command identifier\n128:                   - label (str, optional): Human-readable command label\n129:                   - caption (str, optional): Short description\n130:                   - description (str, optional): Detailed usage information\n131:                   - args (dict, optional): Command argument schema\n132:               - error (str, optional): Error message if the operation failed\n133: \n134:     Examples:\n135:         >>> # Get all commands\n136:         >>> await list_all_commands()\n137:         {'success': True, 'commandCount': 150, 'commands': [...]}\n138: \n139:         >>> # Filter commands by query\n140:         >>> await list_all_commands(query=\"notebook\")\n141:         {'success': True, 'commandCount': 25, 'commands': [...]}\n142:     \"\"\"\n143:     args = {}\n144:     if query is not None:\n145:         args[\"query\"] = query\n146: \n147:     return await emit_and_wait_for_result(\n148:         {\"name\": \"jupyterlab-commands-toolkit:list-all-commands\", \"args\": args}\n149:     )\n150: \n151: \n152: async def execute_command(command_id: str, args: Optional[dict] = None) -> dict:\n153:     \"\"\"\n154:     Execute a JupyterLab command with optional arguments.\n155: \n156:     This function sends a command execution request to the JupyterLab frontend\n157:     and waits for the result. The command is identified by its unique command_id\n158:     and can be parameterized with optional arguments.\n159: \n160:     Args:\n161:         command_id (str): The unique identifier of the JupyterLab command to execute.\n162:                          This should be a valid command ID registered in JupyterLab.\n163:         args (Optional[dict], optional): A dictionary of arguments to pass to the\n164:                                        command. Defaults to None, which is converted\n165:                                        to an empty dictionary.\n166: \n167:     Returns:\n168:         dict: A dictionary containing the command execution response from JupyterLab.\n169:               The structure typically includes:\n170:               - success (bool): Whether the command executed successfully\n171:               - result (any): The return value from the executed command\n172:               - error (str, optional): Error message if the command failed\n173:               - request_id (str): The unique identifier for this request\n174: \n175:     Examples:\n176:         >>> await execute_command(\"application:toggle-left-area\")\n177:         {'success': True, 'result': None}\n178: \n179:         >>> await execute_command(\"docmanager:open\", {\"path\": \"notebook.ipynb\"})\n180:         {'success': True, 'result': 'opened'}\n181:     \"\"\"\n182:     if args is None:\n183:         args = {}\n184:     return await emit_and_wait_for_result({\"name\": command_id, \"args\": args})\n\n(End of file - total 184 lines)\n</content>"
