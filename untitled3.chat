ndary <- function(fit, grid) {\n    preds <- fit |>\n        predict(new_data = grid, type = 'prob') |>\n        bind_cols(grid)\n\n    ggplot(preds, aes(x = danceability, y = tempo)) +\n        geom_tile(aes(fill = .pred_edm)) + \n        geom_contour(aes(z = .pred_edm), breaks = 0.5, color = 'black') +\n        scale_fill_gradient2(low = 'steelblue', mid = 'white', high = 'darkorange', \n                             midpoint = 0.5, limits = c(0, 1))\n    }\n\nplot_boundary(fit_logit, grid)\n    \n\n=== cell 22\nplot_boundary(fit_rf, grid)\n\nfit_rf |> \n    predict(new_data = songs, type = 'class') |>\n    bind_cols(songs) |>\n    summarize(accuracy = mean(.pred_class == genre))\n\n"
