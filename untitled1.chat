              "content": "pred_own <- predict(fit_logit, new_data = gss, type = 'prob') |> pull(.pred_yes)\n\npred_plus1 <- predict(fit_logit, new_data = gss |> mutate(educ = educ + 1), type = 'prob') |> pull(.pred_yes)\n\nmean(pred_plus1 - pred_own)",
