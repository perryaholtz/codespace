              "cwd": "/workspaces/codespace",
              "command": "python3 - <<'EOF'\nimport json\nnb=json.load(open('exercises/17-encoder-exercise.ipynb'))\nfor i in (2,16,22):\n    c=nb['cells'][i]\n    print('=== cell',i,c['id'],c['cell_type'],'exec=',c.get('execution_count'),'===')\n    print(''.join(c['source']))\n    print()\nEOF"
