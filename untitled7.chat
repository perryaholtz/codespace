ta\": {},\n-   \"outputs\": [],\n+   \"outputs\": [\n+    {\n+     \"data\": {\n+      \"text/plain\": [\n+       \"[1] 1000\"\n+      ]\n+     },\n+     \"execution_count\": 15,\n+     \"metadata\": {},\n+     \"output_type\": \"execute_result\"\n+    }\n+   ],\n    \"source\": [\n     \"set.seed(512)\\n\",\n     \"\\n\",\n@@ -177,12 +309,18 @@\n   },\n   {\n    \"cell_type\": \"code\",\n-   \"execution_count\": null,\n+   \"execution_count\": 16,\n    \"id\": \"cdf8feb3\",\n    \"metadata\": {},\n    \"outputs\": [],\n    \"source\": [\n-    \"# Fit your model here\"\n+    \"# Fit your model here\\n\",\n+    \"set.seed(1)\\n\",\n+    \"\\n\",\n+    \"rf_fit <- rand_forest(trees = 200) |>\\n\",\n+    \"    set_mode('classification') |>\\n\",\n+    \"    set_engine('ranger') |>\\n\",\n+    \"    fit(label ~ ., data = train)\"\n    ]\n   },\n   {\n@@ -210,12 +348,28 @@\n   },\n   {\n    \"cell_type\": \"code\",\n-   \"execution_count\": null,\n+   \"execution_count\": 17,\n    \"id\": \"6cc8d855\",\n    \"metadata\": {},\n-   \"outputs\": [],\n+   \"outputs\": [\n+    {\n+     \"data\": {\n+      \"text/plain\": [\n+       \"[1] 0.998\"\n+      ]\n+     },\n+     \"execution_count\": 17,\n+     \"metadata\": {},\n+     \"output_type\": \"execute_result\"\n+    }\n+   ],\n    \"source\": [\n-    \"# Accuracy on the test set\"\n+    \"# Accuracy on the test set\\n\",\n+    \"test_pred <- predict(rf_fit, new_data = test)$.pred_class\\n\",\n+    \"mean(test_pred == test$label)\\n\",\n+    \"\\n\",\n+    \"train_pred <- predict(rf_fit, new_data = train)$.pred_class\\n\",\n+    \"mean(train_pred == train$label)\"\n    ]\n   },\n   {\n@@ -229,6 +383,14 @@\n     \"- Is the accuracy on `train` higher than on `test`? What does that tell you?\"\n    ]\n   },\n+  {\n+   \"cell_type\": \"markdown\",\n+   \"id\": \"0013c1b6-2fb9-4978-b436-82b97e756000\",\n+   \"metadata\": {},\n+   \"source\": [\n+    \"I picked random forest because I am familiar with how it works and thought it could map the data well. The accuracy on train is higher than the accuracy on test because it is trained to the training data, it doesn't know the test data. This might result in overfitting.\"\n+   ]\n+  },\n   {\n    \"cell_type\": \"markdown\",\n    \"id\": \"fac86276\",\n@@ -285,4 +447,4 @@\n  },\n  \"nbformat\": 4,\n  \"nbformat_minor\": 5\n-}\n\\ No newline at end of file\n+}",
